# Copy to .env and fill in. Never commit .env.

# Database (local: Docker Postgres; prod: Northflank Postgres addon)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/shelflife

# Auth (Better Auth + Google sign-in)
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI (Gemini API free tier, from Google AI Studio). Leave empty locally to use the mock provider.
GEMINI_API_KEY=
AI_DAILY_LIMIT=30

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Sync service
SYNC_JWT_SECRET=

# URLs
# Web app origin. Locally the Vite dev server proxies /api to the API, so the browser only sees this origin.
APP_URL=https://localhost:5173
# API port (local)
PORT=8787
SYNC_URL=ws://localhost:1234
