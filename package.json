{
  "name": "shelf-life",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @shelf-life/web --filter @shelf-life/api --filter @shelf-life/sync dev",
    "build": "pnpm -r build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm --filter @shelf-life/web test:e2e",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres",
    "db:generate": "pnpm --filter @shelf-life/api db:generate",
    "db:migrate": "pnpm --filter @shelf-life/api db:migrate",
    "stories": "pnpm --filter @shelf-life/web stories",
    "db:seed": "pnpm --filter @shelf-life/api db:seed",
    "receipts:label": "pnpm --filter @shelf-life/web receipts:label",
    "receipts:score": "pnpm --filter @shelf-life/receipt-tests score"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
